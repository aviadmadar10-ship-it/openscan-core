```yaml name: OpenScan 3D - Automated Release APK on: workflow_dispatch: push: branches: [ "main" ] jobs: build_apk: name: Build OpenScan 3D Android APK runs-on: ubuntu-latest steps: - name: Checkout Repository uses: actions/checkout@v4 - name: Setup Java 17 uses: actions/setup-java@v4 with: distribution: 'temurin' java-version: '17' - name: Setup Flutter SDK uses: subosito/flutter-action@v2 with: channel: 'stable' cache: true - name: Prepare Clean Flutter Project run: | # יצירת שלד פרויקט Flutter נקי ותקני flutter create --org com.openscan3d --project-name openscan3d app_runner cd app_runner # אם קיים main.dart במאגר, נעתיק אותו לשלד if [ -f "../lib/main.dart" ]; then cp ../lib/main.dart lib/main.dart echo "✓ Copied root lib/main.dart" elif [ -f "../mobile_app/lib/main.dart" ]; then cp ../mobile_app/lib/main.dart lib/main.dart echo "✓ Copied mobile_app/lib/main.dart" fi # התקנת תלויות בסיס וקימפול ישיר flutter pub get flutter build apk --release - name: Upload APK to Artifacts uses: actions/upload-artifact@v4 with: name: OpenScan3D-v1.0-release path: app_runner/build/app/outputs/flutter-apk/app-release.apk ```
