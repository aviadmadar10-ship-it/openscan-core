```yaml name: OpenScan 3D - Build Android APK on: workflow_dispatch: push: branches: [ "main" ] jobs: build: name: Build & Generate APK runs-on: ubuntu-latest steps: - name: Checkout Source Code uses: actions/checkout@v4 - name: Set up Java 17 uses: actions/setup-java@v4 with: distribution: 'temurin' java-version: '17' - name: Set up Flutter SDK uses: subosito/flutter-action@v2 with: channel: 'stable' cache: true - name: Assemble & Compile Clean APK run: | set -e echo "==> Creating clean Flutter container..." flutter create --org com.openscan3d --project-name openscan3d builder_app echo "==> Injecting OpenScan 3D main application code..." if [ -f "lib/main.dart" ]; then cp lib/main.dart builder_app/lib/main.dart echo "Copied from lib/main.dart" elif [ -f "mobile_app/lib/main.dart" ]; then cp mobile_app/lib/main.dart builder_app/lib/main.dart echo "Copied from mobile_app/lib/main.dart" fi cd builder_app echo "==> Getting dependencies..." flutter pub get echo "==> Building Release APK..." flutter build apk --release - name: Upload Finished APK Artifact uses: actions/upload-artifact@v4 with: name: OpenScan3D-v1.0-release path: builder_app/build/app/outputs/flutter-apk/app-release.apk ``
